# Copy to .env on the server (next to docker-compose.yml) and fill in. chmod 600 .env
# API and worker read everything; the frontend only gets GOOGLE_CLIENT_ID (see docker-compose.yml).

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database (production PostgreSQL, database "myexp") --------------------------
DB_HOST=<postgres-container-name>
DB_PORT=5432
DB_NAME=myexp
DB_USER=myexp_app
DB_PASSWORD=
WORKER_DB_USER=myexp_worker
WORKER_DB_PASSWORD=

# --- Qdrant (internal network) ---------------------------------------------------
QDRANT_URL=http://<qdrant-container-name>:6333
QDRANT_API_KEY=

# --- Files (Azure Blob Storage) ------------------------------------------------------
# "container/prefix": use a production prefix of its own (e.g. myexp/prd)
FILES_CONTAINER=myexp/prd
STG_ACCOUNT_NAME=
STG_ACCOUNT_KEY=

# --- Login -------------------------------------------------------------------------
AUTH_GOOGLE_CLIENT_IDS=
AUTH_ADMIN_EMAILS=
# Same value as AUTH_GOOGLE_CLIENT_IDS (goes to the frontend container)
GOOGLE_CLIENT_ID=

# --- AI (free tiers only) -------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
LLM_VISION_MODELS=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,gemini:gemini-flash-latest,cloudflare:@cf/qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3.5-super-vl:free
LLM_TEXT_MODELS=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.1-flash-lite,openrouter:nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODELS=gemini:gemini-embedding-001,cloudflare:@cf/baai/bge-m3
