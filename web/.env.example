# Copy to web/.env.local.

# FastAPI URL, used ONLY by the Next.js server (never exposed to the browser).
API_URL=http://127.0.0.1:8000

# Shows the development login (the API's /auth/dev-login).
# The API also needs ENVIRONMENT=development; keep false in production.
DEV_LOGIN_ENABLED=true

# Google OAuth Client ID (same value as AUTH_GOOGLE_CLIENT_IDS in the API).
# Not a secret: it goes to the browser. The client secret is NOT used.
# In Google Cloud Console, "Authorized JavaScript origins": http://localhost:3100 and http://localhost.
GOOGLE_CLIENT_ID=
