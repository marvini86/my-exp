# Copy to api/.env and fill in. Never commit the real .env.

# development enables /auth/dev-login, the dev auth header and /docs.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Browser origins allowed by CORS (the Next.js server calls the API server-side).
CORS_ORIGINS=http://localhost:3100

# --- Database (PostgreSQL 16+) -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=myexp_dev
# API: role myexp_app (no SUPERUSER/BYPASSRLS, so row-level security applies)
DB_USER=myexp_app
DB_PASSWORD=change-me
# Worker: role myexp_worker
WORKER_DB_USER=myexp_worker
WORKER_DB_PASSWORD=change-me

# --- Vector search (Qdrant) -----------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=expense_documents

# --- File storage (Azure Blob Storage) --------------------------------------------
# "container" or "container/prefix" (e.g. myexp/dev)
FILES_CONTAINER=myexp/dev
STG_ACCOUNT_NAME=
STG_ACCOUNT_KEY=

# --- Login ------------------------------------------------------------------------
# Google OAuth Client IDs accepted as the ID token audience (comma-separated).
AUTH_GOOGLE_CLIENT_IDS=
# Platform admins: manage which e-mails may sign up (comma-separated).
AUTH_ADMIN_EMAILS=

# --- AI providers (free tiers only) -----------------------------------------------
# Routes are "provider:model"; the router falls back to the next one on rate limits.
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
LLM_VISION_MODELS=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,cloudflare:@cf/qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3.5-super-vl:free
LLM_TEXT_MODELS=groq:openai/gpt-oss-120b,cloudflare:@cf/openai/gpt-oss-120b,gemini:gemini-3.1-flash-lite,openrouter:nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODELS=gemini:gemini-embedding-001,cloudflare:@cf/baai/bge-m3
